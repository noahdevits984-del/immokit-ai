# Copie ce fichier en .env.local pour le développement local.
# Ne mets JAMAIS ces valeurs dans le code ni dans un commit.

# Mot de passe de la page /direct
QG_PASSWORD=

# Compte de service Google (lecture seule)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clé privée du fichier JSON (champ "private_key"), entre guillemets, avec les \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Feuille du QG (onglets Arrêts, Trades, Prospects, Vidéos, Produits)
QG_SHEET_ID=
# Journal d'actualités
QG_JOURNAL_SHEET_ID=
# Dossier Drive « vidéo TikTok »
QG_DRIVE_FOLDER_ID=
